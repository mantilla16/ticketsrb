# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
**/dist/
**/build/

# Environment variables — NEVER subir al repo
# El patrón amplio es a propósito: un .env.respaldo o .env.produccion.bak se
# cuela con `git add -A` si solo se ignoran los nombres exactos.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/settings.json

# Docker volumes (datos locales de PG)
pgdata/

# Adjuntos subidos por los solicitantes — viven en el disco del servidor,
# nunca en el repo (el despliegue hace `git reset --hard` y no los toca).
autotrack-backend/uploads/

# Autorización de correo — credencial viva
correo-token.json
**/correo-token.json*

# Respaldos y borradores locales
*.bak
*.bak_*
autotrack-backend/test-*.js

