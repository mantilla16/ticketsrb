PORT=3001
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/autotrack
JWT_SECRET=cambia_este_secreto_super_seguro_aqui
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ── Identidad de la firma ────────────────────────────────────────────────
# Dominio institucional que puede entrar. El login con Microsoft se restringe a
# él y la pantalla de acceso lo muestra como pista al usuario.
AUTH_ALLOWED_DOMAIN=rbcol.co

# Orígenes extra permitidos por CORS, separados por coma (integraciones,
# despliegue público). FRONTEND_URL ya va incluido.
# CORS_ORIGINS=https://mesa.rbcol.co,https://n8n.rbcol.co

# ── Login con Microsoft 365 (Entra ID) ───────────────────────────────────
# Del registro de la aplicación en portal.azure.com → Microsoft Entra ID →
# App registrations. Ninguno de los dos es secreto: una SPA usa PKCE y no
# necesita secreto de cliente.
#   MS_CLIENT_ID  = «Id. de aplicación (cliente)»
#   MS_TENANT_ID  = «Id. de directorio (inquilino)»
MS_CLIENT_ID=
MS_TENANT_ID=

# Atajo de acceso sin Microsoft. Solo funciona con NODE_ENV != production.
ALLOW_DEV_LOGIN=false

# ── Correo saliente ──────────────────────────────────────────────────────
# Dos caminos. Si MS_CLIENT_SECRET está definido se usa Microsoft Graph; si
# no, SMTP. Todos los avisos salen del mismo buzón y el Reply-To apunta a
# quien hizo el cambio.
#
# RECOMENDADO — Graph con permiso DELEGADO. Es lo que funciona con
# verificación en dos pasos, donde la contraseña del buzón no sirve y las
# contraseñas de aplicación están deshabilitadas.
#
# Se autoriza una sola vez, desde el servidor:
#     node scripts/autorizar-correo.js
#
# Lo consiente la propia persona —Mail.Send delegado no necesita
# administrador global— y solo permite enviar como ella. En el servidor queda
# un refresh token, revocable desde la cuenta sin tocar nada más.
#
# En el registro de Entra: permiso DELEGADO Mail.Send, y «Permitir flujos de
# cliente público» = Sí.
MAIL_FROM=
# MAIL_TOKEN_FILE=/var/www/mesa-servicio/correo-token.json

# PLAN B — Graph con permiso de APLICACIÓN. No depende de ninguna persona,
# pero Mail.Send de aplicación deja enviar como CUALQUIER buzón del inquilino:
# exige consentimiento de administrador y conviene acotarlo con
# New-ApplicationAccessPolicy.
MS_CLIENT_SECRET=

# ALTERNATIVA — SMTP. Solo viable si el buzón no tiene verificación en dos
# pasos y el inquilino permite SMTP AUTH.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Remitente de respaldo para el Reply-To cuando no se conoce el autor.
REPORT_FROM_EMAIL=

# URL pública que se enlaza desde los correos de notificación.
FRONTEND_URL_PUBLIC=https://mesa.rbcol.co
